# Copy to .env.development / .env.staging / .env.production and fill in.
# Never commit real values.
NODE_ENV=
PORT=
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORTAL_ORIGIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only needed when not running under an IAM role. Needs cognito-idp:ListUsers,
# cognito-idp:AdminDeleteUser (account deletion), cognito-idp:AdminDisableUser
# (an admin removing a user) and cognito-idp:AdminCreateUser (invitations) on
# COGNITO_USER_POOL_ID.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# File storage: one private S3 bucket with documents/, photos/ and avatars/
# folders (see README "File storage"). Credentials need s3:PutObject,
# s3:GetObject, s3:DeleteObject on those folders and s3:ListBucket.
S3_PORTAL_STORAGE_BUCKET=
AWS_REGION=
# Knowledge indexing (extract → chunk → embed). The worker runs inside the
# API unless KNOWLEDGE_INDEXING_ENABLED=false. Credentials need
# bedrock:InvokeModel on the embedding model (and, with OCR on,
# textract:StartDocumentTextDetection + textract:GetDocumentTextDetection).
# Defaults: amazon.titan-embed-text-v2:0, AWS_REGION, OCR off, 200 MB.
KNOWLEDGE_INDEXING_ENABLED=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_REGION=
TEXTRACT_OCR_ENABLED=
KNOWLEDGE_INDEXING_MAX_MB=

# Admin AI configuration (Platform AI card + prompt Test button). Claude
# models on Bedrock need a cross-region inference profile id. Defaults:
# au.anthropic.claude-sonnet-4-5-20250929-v1:0 (answers) and
# au.anthropic.claude-haiku-4-5-20251001-v1:0 (background), region
# BEDROCK_REGION → AWS_REGION → ap-southeast-2. Credentials need
# bedrock:InvokeModel on the answer model's inference profile.
BEDROCK_ANSWER_MODEL_ID=
BEDROCK_BACKGROUND_MODEL_ID=

# Technician AI assistant (POST /ai/ask). Needs
# bedrock:InvokeModelWithResponseStream on the answer and light models'
# inference profiles. Simple questions (no photo, all limits met) go to
# the light model (default BEDROCK_BACKGROUND_MODEL_ID). Defaults: routing
# on, 200 question chars, 4000 context chars, 4 history messages, 4096
# answer tokens.
BEDROCK_LIGHT_MODEL_ID=
BEDROCK_LIGHT_ROUTING_ENABLED=
BEDROCK_LIGHT_MAX_QUESTION_CHARS=
BEDROCK_LIGHT_MAX_CONTEXT_CHARS=
BEDROCK_LIGHT_MAX_HISTORY_MESSAGES=
BEDROCK_ANSWER_MAX_TOKENS=

# Data & retention (migrations 0046–0049).
# The service role (field_service): billing module + background jobs. Falls
# back to DATABASE_URL (with a warning) if unset — local dev only.
SERVICE_DATABASE_URL=
# Stripe — read only by src/billing. The webhook endpoint is
# POST /billing/stripe/webhook; both unset = billing disabled (503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nightly AI query log purge (per-organisation retention). Default on, at
# 17:00 UTC.
AI_LOG_RETENTION_JOB_ENABLED=
AI_LOG_RETENTION_HOUR_UTC=
# "My data" export worker (needs S3; writes exports/ — add exports/* to the
# IAM policy). Default on.
DATA_EXPORT_WORKER_ENABLED=

# Dashboard: support case response targets in hours from creation; an open
# case past its target counts as "breaching SLA". Defaults 4 / 24 / 72.
SUPPORT_SLA_HOURS_P1=
SUPPORT_SLA_HOURS_P2=
SUPPORT_SLA_HOURS_P3=
# Support cases: the hourly job closing cases resolved 7+ days ago. Default
# on. Replies email the other side through SES (SES_FROM_EMAIL, below,
# with NOTIFICATIONS_ENABLED=true); links use the first PORTAL_ORIGIN.
SUPPORT_CASE_AUTO_CLOSE_ENABLED=


# Email (Amazon SES) for alerts and scheduled reports. SES_FROM_EMAIL must
# be a verified SES identity in SES_REGION (default AWS_REGION); while SES
# is in sandbox mode, recipients must be verified too. Credentials need
# ses:SendEmail + ses:SendRawEmail on identity/* and configuration-set/*.
SES_FROM_EMAIL=
SES_FROM_NAME=
SES_REGION=
# SMS (Amazon SNS) for P1 alerts. Credentials need sns:Publish. New
# accounts are in the SMS sandbox (verified numbers only).
SNS_SMS_SENDER_ID=
SNS_SMS_TYPE=Transactional
# true sends email/SMS; anything else only logs what would be sent.
NOTIFICATIONS_ENABLED=
# false stops the alert rule checks (src/alertEngine).
ALERT_ENGINE_ENABLED=
# false stops the scheduled report emails (src/adminReports).
SCHEDULED_REPORTS_WORKER_ENABLED=

# Demo requests from the marketing site (src/demoRequests).
# Comma-separated sales inboxes notified of each new request (via SES).
# DEMO_NOTIFY_EMAIL is still read as a fallback.
DEMO_REQUEST_NOTIFY_TO=
# Origins allowed to call /public/* (comma-separated). No other route
# accepts them. Default http://localhost:3000. PUBLIC_CORS_ORIGINS is
# still read as a fallback.
CORS_ALLOWED_ORIGINS=https://quiptechfield.com.au,https://www.quiptechfield.com.au
# Number of proxies (load balancer, CDN) in front of the API, so the demo
# form's per-IP rate limit sees the real client IP. Unset/0 = direct.
# On EC2 the deploy's compose file sets it to 1 (Caddy).
TRUST_PROXY_HOPS=

# Migrations only (deploy's `migrate` service, db/applyMigrations.sh) — an
# admin/owner role. Kept in its own SSM parameter, never in the API's env.
MIGRATION_DATABASE_URL=
