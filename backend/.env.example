# Copy to .env.development / .env.staging / .env.production and fill in.
# Never commit real values.
NODE_ENV=
PORT=
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PORTAL_ORIGIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only needed when not running under an IAM role. Needs cognito-idp:ListUsers
# and cognito-idp:AdminDeleteUser on COGNITO_USER_POOL_ID (account deletion).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# File storage: one private S3 bucket with documents/, photos/ and avatars/
# folders (see README "File storage"). Credentials need s3:PutObject,
# s3:GetObject, s3:DeleteObject on those folders and s3:ListBucket.
S3_PORTAL_STORAGE_BUCKET=
AWS_REGION=
# Knowledge indexing (extract → chunk → embed). The worker runs inside the
# API unless KNOWLEDGE_INDEXING_ENABLED=false. Credentials need
# bedrock:InvokeModel on the embedding model (and, with OCR on,
# textract:StartDocumentTextDetection + textract:GetDocumentTextDetection).
# Defaults: amazon.titan-embed-text-v2:0, AWS_REGION, OCR off, 200 MB.
KNOWLEDGE_INDEXING_ENABLED=
BEDROCK_EMBEDDING_MODEL_ID=
BEDROCK_REGION=
TEXTRACT_OCR_ENABLED=
KNOWLEDGE_INDEXING_MAX_MB=

# Admin AI configuration (Platform AI card + prompt Test button). Claude
# models on Bedrock need a cross-region inference profile id. Defaults:
# au.anthropic.claude-sonnet-4-5-20250929-v1:0 (answers) and
# au.anthropic.claude-haiku-4-5-20251001-v1:0 (background), region
# BEDROCK_REGION → AWS_REGION → ap-southeast-2. Credentials need
# bedrock:InvokeModel on the answer model's inference profile.
BEDROCK_ANSWER_MODEL_ID=
BEDROCK_BACKGROUND_MODEL_ID=

# Data & retention (migrations 0046–0049).
# The service role (field_service): billing module + background jobs. Falls
# back to DATABASE_URL (with a warning) if unset — local dev only.
SERVICE_DATABASE_URL=
# Stripe — read only by src/billing. The webhook endpoint is
# POST /billing/stripe/webhook; both unset = billing disabled (503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Nightly AI query log purge (per-organisation retention). Default on, at
# 17:00 UTC.
AI_LOG_RETENTION_JOB_ENABLED=
AI_LOG_RETENTION_HOUR_UTC=
# "My data" export worker (needs S3; writes exports/ — add exports/* to the
# IAM policy). Default on.
DATA_EXPORT_WORKER_ENABLED=
