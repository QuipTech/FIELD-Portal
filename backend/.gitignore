# dependencies
/node_modules

# build output
/dist

# typescript
*.tsbuildinfo

# env files (hold real DB endpoints — never commit; keep .env.example as the template)
.env
.env.*
!.env.example

# secrets & certificates — never commit
/certs/*
*.pem
*.p8
*.key
*.cert
*.crt
# Amazon's public RDS CA bundle — not a secret, required at runtime by database.service.ts
!/certs/rdsGlobalBundle.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# testing
/coverage

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
